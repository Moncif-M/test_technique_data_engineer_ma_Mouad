# Optional: copy this file to .env to override the defaults in docker-compose.yml.
# Every value below is already the default, so docker compose up works without it.
# These are local-development values only, not real secrets.

# Object store (Silo)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
LAKE_BUCKET=lake
S3_ENDPOINT=http://silo:9000

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW__WEBSERVER__SECRET_KEY=taxi-pipeline-local-dev-key
AIRFLOW__CORE__FERNET_KEY=

# Spark (lower to 2g on a machine with 8 GB of RAM or less)
SPARK_DRIVER_MEMORY=3g

# Warehouse (Postgres serving the gold tables)
WAREHOUSE_USER=analytics
WAREHOUSE_PASSWORD=analytics
WAREHOUSE_DB=analytics

# Not read by Docker: scripts/get_data.py reads it from your shell
# (export SODA_APP_TOKEN=...) to avoid API throttling.
